# Local model is primary. Cloud APIs are opt-in, even if keys are present.
MODEL_PROVIDERS=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# Optional ordered fallback: MODEL_PROVIDERS=ollama,groq

# Cloud providers are used ONLY when listed in MODEL_PROVIDERS above; a key
# alone does not switch them on. Keep these accounts on their FREE tier.
# Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback. Leave blank to pause when Groq is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEARXNG_URL=http://127.0.0.1:8080

# Local scheduling budgets, not provider guarantees. Lower to match your account.
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000
GEMINI_RPM=5
GEMINI_TPM=20000
GEMINI_RPD=100
GEMINI_TPD=200000
